# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Build outputs / patched firmware (never commit firmware images)
build/
out/
out8/
out_m2/
# local screenshots from hardware and page checks
shots/
*.bin
*.hex
site/shop/.tmp-stock/
!mods/**/*.bin

# Reverse-engineering workspaces (large / regenerable)
ghidra_projects/
*.gpr
*.rep/
*.gzf
extracted/

# Stock firmware must never be committed (user supplies their own)
firmware/
stock/
# ...except the shop's patch files: put/copy ops and hashes, no Dirtywave bytes (make_firmware.py, CI reads them)
!site/shop/firmware/

# Dirtywave's manual and its text dump: local research only, never committed
manuals/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Built mods are artifacts (mkmod rebuilds them from mods/<name>/ and examples/<name>/).
# The sources (mod.json, *.s) are tracked; the compiled .m8mod are not, except test fixtures.
mods/**/*.m8mod
examples/**/*.m8mod
!tests/fixtures/**

# The published catalog site/mods/*.m8mod IS tracked (built locally, carries only
# hashes + author bytes -- it is the distributable unit). But the site's generated
# outputs are not: make_site.py / the pages workflow rebuild them.
site/engine/
site/catalog.json

# Local editor / harness config
.claude/
